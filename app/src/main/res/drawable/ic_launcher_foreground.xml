<?xml version="1.0" encoding="utf-8"?>
<!--
  图标：白色对话气泡 + 笑脸（眼睛/嘴角用暖橙色）
  108x108 画布，内容压在中心 72dp 安全区内，任何裁切形状（圆/方/水滴）都不会切到脸。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 整体缩到 0.76：启动器裁圆形时背景渐变环还能露出来 -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.76"
        android:scaleY="0.76">

        <!-- 气泡尾巴 -->
        <path
            android:pathData="M33,68 L33,87 L50,68 Z"
            android:fillColor="#F7FFFFFF" />

        <!-- 气泡主体 -->
        <path
            android:pathData="M34,24 L74,24 A13,13 0 0 1 87,37 L87,63 A13,13 0 0 1 74,76 L34,76 A13,13 0 0 1 21,63 L21,37 A13,13 0 0 1 34,24 Z"
            android:fillColor="#F7FFFFFF" />

        <!-- 左眼 -->
        <path
            android:pathData="M36,47 q5,-7 10,0"
            android:strokeColor="#F07A2B"
            android:strokeWidth="4.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- 右眼 -->
        <path
            android:pathData="M62,47 q5,-7 10,0"
            android:strokeColor="#F07A2B"
            android:strokeWidth="4.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- 笑 -->
        <path
            android:pathData="M37,55 q17,15 34,0"
            android:strokeColor="#F07A2B"
            android:strokeWidth="4.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
